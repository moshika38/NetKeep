<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Network access for the HTTP/HTTPS keep-alive probes. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground Service Permissions: the keep-alive service runs as a
         "specialUse" foreground service (the same category Z Pinger uses for
         continuous connectivity probes). A dataSync service would be time
         limited to 6h/day on Android 14+, which is incompatible with a
         keep-alive service that must run indefinitely. FOREGROUND_SERVICE_
         SPECIAL_USE is required on Android 14+ for the specialUse type;
         POST_NOTIFICATIONS is the Android 13+ runtime permission for the
         persistent notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Partial CPU wake lock: keeps the probe schedule exact while the screen
         is off. Battery Saver releases it so Android may sleep the CPU and the
         ping cadence becomes best-effort. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Restarts the keep-alive service after a device reboot when the user had
         it running before the reboot (same behavior as Z Pinger's boot
         receiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Data Usage Stats Permission -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:label="NetKeep"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>

        <!-- flutter_background_service foreground service. The plugin merges
             its own declaration of id.flutter.flutter_background_service.
             BackgroundService (stopWithTask=false, so probing continues when
             the app is swiped away); this re-declaration adds the specialUse
             type (required on Android 14+) and its Play-review justification.
             The plugin also ships its own BootReceiver/WatchdogReceiver for
             automatic resume after reboot. -->
        <service
            android:name="id.flutter.flutter_background_service.BackgroundService"
            android:foregroundServiceType="specialUse"
            tools:node="merge">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Pinging networks and logging connection health and latency statistics." />
        </service>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
