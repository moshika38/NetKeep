<?xml version="1.0" encoding="utf-8"?>
<!--
    Monochrome wifi glyph used as the static status-bar small icon of the
    keep-alive foreground notification whenever the live speed readout is off.
    Same design as the app's ic_stat_netkeep vector so both states are visually
    consistent.

    Android notification small-icon rules honored here:
      * single-color white silhouette (the OS tints it with the status-bar
        accent, so no `android:tint` attribute is set - an explicit tint on the
        drawable can fight the system tint and render as a solid blob);
      * the glyph is uniformly scaled into the central ~72% of the 24x24
        viewport (content x in ~[2.5, 21.5], y in ~[4.4, 19.6]). Android 12+
        insets/masks small icons, so a glyph that touches the canvas edges gets
        clipped and can look like a broken/generic icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
